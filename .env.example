VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only Supabase configuration. Never use VITE_ on secret values.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Server-only credentials. Never use VITE_ for secret values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public payment instructions shown to donors, for example your official UPI ID.
# Do not put bank passwords, PINs, card details, or private credentials here.
GOODFOOD_MANUAL_PAYMENT_INSTRUCTIONS=
